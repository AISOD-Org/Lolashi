{
    "title": "orders",
    "type": "object",
    "properties": {
        "id": {
            "type": "integer",
            "autoIncrement": true
        },
        "customer_name": {
            "type": "string",
            "maxLength": 200
        },
        "customer_email": {
            "type": "string",
            "maxLength": 200
        },
        "customer_phone": {
            "type": "string",
            "maxLength": 50
        },
        "delivery_address": {
            "type": "string",
            "maxLength": 500
        },
        "quantity": {
            "type": "integer",
            "default": 1
        },
        "total_amount": {
            "type": "number"
        },
        "status": {
            "type": "string",
            "maxLength": 50,
            "default": "pending"
        },
        "stripe_session_id": {
            "type": "string",
            "maxLength": 200
        }
    },
    "required": [
        "customer_name",
        "customer_email",
        "delivery_address",
        "quantity",
        "total_amount"
    ]
}